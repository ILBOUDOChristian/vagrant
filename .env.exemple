# ==============================================================================
# RÉSULTATS-BF — Modèle de configuration d'environnement (.env.exemple)
# ==============================================================================
# RÈGLE ACADÉMIQUE : Ce fichier est versionné dans Git et sert de gabarit.
# Pour déployer, copier ce fichier vers '.env' :
#   PowerShell : Copy-Item .env.exemple .env
#   Bash       : cp .env.exemple .env
# Le fichier '.env' est strictement ignoré par Git (sécurité des credentials).
# Toutes les valeurs ci-dessous sont fonctionnelles par défaut pour un test local.
# ==============================================================================

# --- IDENTIFICATION DE L'ÉQUIPE ET RÉSEAU PRIVÉ VIRTUALBOX ---
# GROUPE_EQUIPE : Numéro attribué à l'équipe sur la liste officielle (ex: 15).
GROUPE_EQUIPE=15

# GROUPE_RESEAU : Numéro de réseau G imposé par le Dr SOMDA (1 à 8).
# Calcul du sous-réseau VirtualBox imposé : 192.168.(55 + G).0/24 (plage autorisée 192.168.56.0/21).
# Pour l'Équipe 15 : 15 mod 8 = 7 -> Réseau 192.168.62.0/24.
GROUPE_RESEAU=7

# --- PARAMÉTRAGE DE LA SCALABILITÉ (EXIGENCE R3) ---
# NB_APP : Nombre de serveurs applicatifs (contrainte obligatoire : minimum 2, max 10).
# Changer NB_APP=4 puis lancer 'vagrant up' reconfigure automatiquement HAProxy.
NB_APP=2

# --- IMAGE VIRTUELLE ET VERSIONS ÉPINGLÉES ---
# Boîte officielle imposée par le sujet : bento/ubuntu-24.04
BOITE_IMAGE=bento/ubuntu-24.04
BOITE_VERSION=202404.26.0

# --- ACCÈS DEPUIS LA MACHINE HÔTE (PORTS FORWARDÉS SUR LE RÉPARTITEUR) ---
# Seul le répartiteur (lb1) expose un port vers l'hôte.
IP_HOTE=127.0.0.1
PORT_HOTE=8080
PORT_INVITE=80

# --- PARAMÈTRES DU SERVICE APPLICATIF PYTHON ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PARAMÈTRES DES NOEUDS DE BASE DE DONNÉES POSTGRESQL ---
BDD_PORT=5432
BDD_HOST_PRIMAIRE=bdd1
BDD_HOST_SECONDAIRE=bdd2

# --- GESTION DU BUDGET MÉMOIRE (SOCLE OBLIGATOIRE <= 3 GO / 3072 MO) ---
# bdd1 (768 Mo) + bdd2 (768 Mo) + app1 (512 Mo) + app2 (512 Mo) + lb1 (512 Mo) = 3072 Mo
MEM_BDD=768
MEM_APP=512
MEM_LB=512

# --- EXTENSIONS D'ARCHITECTURE ---
# ACTIVER_EXTENSION_E1 : Activer le répartiteur redondant lb2 avec Keepalived / VRRP (true/false)
ACTIVER_EXTENSION_E1=false
VIP_RESEAU=5

# --- IDENTIFIANTS POSTGRESQL (VALEURS DE DÉVELOPPEMENT / DÉMONSTRATION) ---
# À personnaliser impérativement dans votre fichier local .env
POSTGRES_USER=resultats_user
POSTGRES_DB=resultats_bf
POSTGRES_PASSWORD=Bf_Examens2026!LocalDev

# --- URL PUBLIQUE POUR L'INTERFACE ET LES TESTS CLIENTS ---
URL_API_BASE=http://127.0.0.1:8080
